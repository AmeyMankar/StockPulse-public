# ── Python / Backend ──────────────────────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/.env            # ← NEVER commit secrets
backend/last_scan.json   # runtime cache
backend/devices.json     # runtime data
backend/.slow_cache.json # slow-source cache (Google Trends, SEC EDGAR)
backend/settings.json   # runtime data
backend/watchlists.json # device tokens — never commit
backend/nohup.out
*.log

