# Reddit API — get from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=StockPulse/1.0 by YourUsername

# Anthropic API — get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Client API key — protects app-facing endpoints (register device, trigger scan,
# watchlist). This value ships inside the iOS app binary, so treat it as
# extractable/public and keep its blast radius low.
# Leave blank to disable auth (local dev only — always set in production)
CLIENT_API_KEY=your_client_api_key

# Ingest API key — protects /scan/ingest, /scan/interval, and device deletion.
# Used ONLY by scan_worker.py (the Mac cron worker). Never put this in the iOS app.
INGEST_API_KEY=your_ingest_api_key

# Directory for persisted JSON files (last_scan.json, devices.json)
DATA_DIR=.

# Redis (optional, for caching — leave blank to use in-memory)
REDIS_URL=redis://localhost:6379

# Server
PORT=8000
HOST=0.0.0.0

# Scan interval in seconds (default 900 = 15 minutes)
SCAN_INTERVAL_SECONDS=900

# APNs Push Notifications — get from Apple Developer Portal
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_BUNDLE_ID=com.yourname.StockPulse
APNS_KEY_PATH=./apns_key.p8
